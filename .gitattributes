# 仓库内文本文件统一用 LF，覆盖本机 core.autocrlf=true
.gitattributes text eol=lf
.gitignore     text eol=lf

*.json  text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.md    text eol=lf
*.py    text eol=lf

# Blender / glTF 产物是二进制，禁止任何换行或文本转换
*.blend   binary
*.blend1  binary
*.glb     binary
*.gltf    binary
*.bin     binary
